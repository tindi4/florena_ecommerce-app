# Copiez ce fichier en ".env" à la racine du projet et adaptez les valeurs.
# Ne commitez JAMAIS le vrai .env.

NODE_ENV=development
PORT=3000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=boutique
DB_PASSWORD=changez-moi
DB_NAME=boutique
# DB_SSL=true   # si votre hébergeur MySQL impose TLS

# --- Authentification ---
# Générez une valeur aléatoire : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire-de-48-caracteres-minimum
JWT_TTL_HOURS=8
# CUSTOMER_TTL_DAYS=30   # durée de connexion d'un client (jours)

# --- CORS / cookies ---
# URL(s) du frontend, séparées par des virgules
CORS_ORIGINS=http://localhost:4200
# lax si frontend et API partagent le même domaine ; none si domaines différents (HTTPS obligatoire)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# TRUST_PROXY=true   # derrière un proxy (Nginx, hébergeur)

# --- Boutique ---
SHOP_NAME=Ma Boutique
SHOP_CURRENCY=XOF

# --- Fichiers ---
UPLOAD_DIR=uploads
# SHOP_ADDRESS=Quartier X, Lomé       # affichés sur la facture PDF
# SHOP_PHONE=+228 90 00 00 00
# SHOP_WHATSAPP=22890000000            # numéro WhatsApp de la boutique (bouton « Continuer sur WhatsApp »)

# --- Livraison ---
DELIVERY_FEE_SUGGESTED=1000          # montant proposé par défaut à l administrateur (il peut saisir n importe quel montant)

# --- Messages WhatsApp / SMS envoyés par l'administrateur ---
PHONE_COUNTRY_CODE=228                # ajouté aux numéros locaux (Togo = 228)
SITE_URL=http://localhost:4200        # adresse publique du site (lien de suivi dans le message)

# --- Sauvegardes (npm run backup) ---
BACKUP_KEEP=14                       # nombre de sauvegardes gardées dans backups/ (les plus anciennes sont supprimées)
# MYSQLDUMP_PATH='C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe'   # si mysqldump n'est pas dans le PATH
